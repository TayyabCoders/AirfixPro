# Public production URL, used for canonical URLs, sitemap and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: email delivery for booking / quotation / contact forms via Resend (https://resend.com).
# Without these, forms show an honest "not connected" message and a prefilled WhatsApp fallback.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "AirFixPro Website <bookings@yourdomain.com>"
INQUIRY_FROM_EMAIL=
# Where submissions are delivered. Defaults to the business email in src/config/site.ts.
INQUIRY_TO_EMAIL=
